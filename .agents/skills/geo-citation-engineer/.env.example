# Required for live Apify fetches (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Optional LLM-as-a-judge. Auto order: Anthropic, then Gemini, then OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google AI Studio: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_JUDGE_MODEL=gemini-3.6-flash

# Fallback judge if Anthropic and Gemini are unset.
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o
